# TypeScript incremental build cache
*.tsbuildinfo

.vercel

# Catalog script run-state (per-machine progress; already-tracked ones kept as-is)
apps/web/scripts/*-state.json
apps/web/scripts/*-state-*.json
apps/web/scripts/bot-roster.json

# Generated script output under scripts/data/ (run reports + resume state; can reach tens of MB).
# Curated, human-reviewed artifacts are named *-review-*.json and stay tracked on purpose --
# e.g. data/alias-tier-review-2026-07-31.json, which README points at as the reviewable output.
apps/web/scripts/data/*-state.json
apps/web/scripts/data/*-report.json
apps/web/scripts/data/*-report-*.json
# The patterns above only caught names ending -state/-report. Audit and cleanup passes added in
# 2026-09 write their findings under other names (kr-scene-clean.json and kr-scene-snapshot.json are
# 16MB each), plus rollback journals and generated one-off SQL. Same rule, wider net: a file a script
# WRITES is not source, whatever it is called.
apps/web/scripts/data/*.bak.json
apps/web/scripts/data/*.ndjson
apps/web/scripts/data/kr-scene-*.json
apps/web/scripts/data/dedup-*.json
apps/web/scripts/data/writepass-*.json
apps/web/scripts/data/unofficial-*.json
apps/web/scripts/data/native-language-*.json
apps/web/scripts/data/kr-cover-*.json
apps/web/scripts/data/stub-itunes-*.json
apps/web/scripts/data/delete-*.sql
apps/web/scripts/data/deezer-cover-coverage.json
apps/web/scripts/data/cover-upgrade*.json
apps/web/scripts/data/cover-swap-revalidation.json
apps/web/scripts/data/romaji-duplicates.json
apps/web/scripts/data/stub-targets-*.json

# Tooling scratch
.understand-anything/
backups/

# Run logs from scripts/ and scripts/data/ — transcripts of a single run, not source.
apps/web/scripts/*.log
apps/web/scripts/data/*.log
