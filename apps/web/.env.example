# Supabase auth and database settings
NEXT_PUBLIC_SUPABASE_URL=https://mmbptchpetwdievhrdsj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qs7nNzJwJPQMDYY2GiSxYg_9nZn2I1i

# Optional server-side Supabase secret key for service-role operations
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Spotify API credentials (client credentials for catalog search + user OAuth for playlist export)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Add this URI in your Spotify app dashboard → Redirect URIs (for playlist export feature):
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Passwords for seeding bot/test accounts (only needed when running seed scripts)
BOT_PASSWORD=your-bot-password
TEST_USER2_PASSWORD=your-test-user2-password

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis (rate limiting + caching — optional, gracefully skipped if missing)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Last.fm API (genre backfill fallback — needed for backfill-genres-lastfm.ts)
LASTFM_API_KEY=your-lastfm-api-key

# Jina AI embeddings (semantic search — needed for backfill:embeddings and live hybrid search)
JINA_API_KEY=your-jina-api-key

# Shared secret for admin-only routes (data seeding + the /admin/reports moderation queue)
SEED_SECRET=pick-any-random-string

# Cron auth for scheduled jobs (Vercel auto-attaches this as a Bearer token to cron requests
# once it's set in the Vercel project's env vars — set it there too, not just here)
CRON_SECRET=pick-any-random-string

# Sentry error monitoring (web) — optional, no-ops until NEXT_PUBLIC_SENTRY_DSN is set
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Push notifications (APNs) — optional, no-ops until APNS_PRIVATE_KEY is set.
# Generate an Auth Key in Apple Developer → Certificates, IDs & Profiles → Keys.
PUSH_WEBHOOK_SECRET=pick-any-random-string
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=GGJ5HX3A4M
APNS_BUNDLE_ID=com.sillajuku.app
APNS_PRIVATE_KEY=your-apns-p8-private-key-contents
# false = sandbox APNs (matches the app's current aps-environment: development entitlement).
# Flip to true only once the iOS app ships with a production/TestFlight provisioning profile.
APNS_PRODUCTION=false

# App Store URL for the invite landing page (app/i/[code]) — falls back to the
# marketing homepage until the app is actually submitted/live (see README).
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID

# Supabase Management API personal access token (dashboard > account > access tokens).
# Lets scripts/db-exec.ts apply migrations/SQL from this machine (no direct DB URL needed).
SUPABASE_ACCESS_TOKEN=sbp_your-access-token
