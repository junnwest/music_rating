TEST_USER2_PASSWORD=your-test-user2-password

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis (rate limiting + caching — optional, gracefully skipped if missing)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Last.fm API (genre backfill fallback — needed for backfill-genres-lastfm.ts)
