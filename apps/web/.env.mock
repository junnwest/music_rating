# Offline mock mode — no real Supabase/network needed (no secrets in here).
# Usage:  npm run mock  (terminal 1)  +  npm run dev:mock  (terminal 2)
# App runs on http://localhost:3100 against the mock backend on :54321.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key
SEED_SECRET=mock-seed-secret
# Keep analytics/limits/external APIs disabled in mock mode (empty on purpose;
# node --env-file sets these before Next loads .env.local, so they win).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
JINA_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
